# JARVIS server — copy to .env and fill in. NEVER commit .env.
# No real values are in this repo — placeholders only.
# The server loads .env at startup via dotenv (see src/index.ts) —
# plain `npm run dev` picks up PORT / JWT_SECRET / DATABASE_URL from it.

# --- Required ---
# DATABASE_URL — and the schema it pairs with (dual-schema rule):
#   SQLite for local dev/tests: file:./dev.db   (the file lives in server/prisma/)
#     pairs with server/prisma/schema.prisma (provider = "sqlite").
#   Postgres for Docker/prod: postgresql://USER:PASSWORD@HOST:5432/jarvis?schema=public
#     pairs with server/prisma/postgres/schema.prisma (provider = "postgresql").
# NEVER mix them: a postgresql:// URL with the sqlite schema (or a file: URL
# with the postgres schema) crashes the server at startup with Prisma P1012.
# The Dockerfile generates its client from the Postgres schema and runs
# migrate deploy against it; docker-compose.yml passes the Postgres URL
# to the container itself, so no .env change is needed for Docker.
DATABASE_URL="file:./dev.db"
# Long random secret. Generate with: openssl rand -hex 32
JWT_SECRET="change-me-to-a-long-random-string"
PORT=4000
NODE_ENV=development
# Public base URL of the customer portal (shown on receipts)
APP_URL="http://localhost:5173"

# --- Owner seed (dev only) ---
# Used by `npm run seed` to create the first ADMIN. Change after first login.
ADMIN_SEED_EMAIL="don@jarvis.local"
ADMIN_SEED_PASSWORD="change-me-after-first-login"

# --- Email (optional — leave blank = SIMULATED mode) ---
# When blank, barcode/receipt emails are logged and stored as SIMULATED;
# no email leaves the server.
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="Jarvis <no-reply@example.com>"

# --- Card payments (optional — leave blank = SIMULATED / manual confirm) ---
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# --- Crypto (optional — leave blank = SIMULATED confirm, Don confirms manually) ---
# Real-provider hook: pick ONE. See server/src/services/crypto.ts.
# When provider keys are set, Don's manual confirm is REFUSED for crypto —
# only the provider webhook (below) or an on-chain check can mark PAID.
BTCPAY_URL=""
BTCPAY_API_KEY=""
COINBASE_COMMERCE_API_KEY=""
# Webhook secrets — the provider signs its callbacks with these (HMAC-SHA256).
# Point the provider at POST /api/webhooks/crypto/btcpay or
# POST /api/webhooks/crypto/coinbase. No secret = the webhook endpoint
# returns 501 and nothing can be confirmed in provider mode.
BTCPAY_WEBHOOK_SECRET=""
COINBASE_WEBHOOK_SECRET=""

# --- reCAPTCHA (optional — leave blank = SIMULATED mode) ---
# When both are blank, the Pay page shows a "Captcha not configured —
# simulated mode" notice and payment submits are NOT blocked; the server
# answers captcha: { simulated: true }. Set them to require a human
# before a customer payment submit (see server/src/services/captcha.ts):
# the site key is public (the portal loads it from
# VITE_RECAPTCHA_SITE_KEY); the secret key is private — NEVER commit it.
# Get both at https://www.google.com/recaptcha/admin (reCAPTCHA v2,
# "I'm not a robot" checkbox).
RECAPTCHA_SECRET_KEY=""
RECAPTCHA_SITE_KEY=""

# --- IP lookup (optional — defaults to free ip-api.com, no key) ---
IP_LOOKUP_BASE_URL="http://ip-api.com"

# --- Example payment handles (Don's already-known handles — NOT secrets) ---
# These are public handles for All Pockets Full Consulting, listed only as
# examples for dev seed data / docs. Never put a private key or seed phrase here.
#   Cash App: $MsCarterb
#   Chime:    $apfmoneygoat
#   Venmo:    @Plummer2002
#   Crypto:   BTC / LTC / XMR public addresses are entered per portal in the app.
