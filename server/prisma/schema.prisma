// JARVIS — Prisma data model. Source of truth for the DB.
// Dev: SQLite (DATABASE_URL=file:./dev.db). Prod: Postgres (see .env.example).
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// NOTE: SQLite has no native enums, so statuses / types are stored as
// plain strings (e.g. "ACTIVE", "TERMINATED"). The API contract is unchanged:
// routes validate them with zod and compare string literals only.

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String?
  role         String   @default("CUSTOMER")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  portals      Portal[]
  methods      PaymentMethod[]
  blockedBy    BlockedUser[]
}

model Portal {
  id          String       @id @default(cuid())
  slug        String       @unique
  name        String
  description String?
  currency    String       @default("USD")
  status      String       @default("ACTIVE")
  ownerId     String
  owner       User         @relation(fields: [ownerId], references: [id])
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  grants   AccessGrant[]
  methods  PortalPaymentMethod[]
  invoices Invoice[]
  traffic  TrafficLog[]
  accounts LinkedAccount[]
  blocked  BlockedUser[]
  idVerifications IdVerification[]
  assets   PortalAsset[]
}

model AccessGrant {
  id         String      @id @default(cuid())
  portalId   String
  portal     Portal      @relation(fields: [portalId], references: [id], onDelete: Cascade)
  email      String
  codeHash   String
  status     String      @default("ACTIVE")
  lastUsedAt DateTime?
  expiresAt  DateTime?
  createdAt  DateTime    @default(now())

  @@unique([portalId, email])
  @@index([email])
}

model PaymentMethod {
  id        String            @id @default(cuid())
  type      String
  label     String
  // Public handle / URL / crypto address only — NEVER a secret or private key.
  handle    String
  details   String? // JSON string, e.g. {"note": "All Pockets Full Consulting"}
  ownerId   String
  owner     User              @relation(fields: [ownerId], references: [id])
  createdAt DateTime          @default(now())

  portals  PortalPaymentMethod[]
  invoices Invoice[]
}

model PortalPaymentMethod {
  id              String        @id @default(cuid())
  portalId        String
  portal          Portal        @relation(fields: [portalId], references: [id], onDelete: Cascade)
  paymentMethodId String
  paymentMethod   PaymentMethod @relation(fields: [paymentMethodId], references: [id], onDelete: Cascade)
  createdAt       DateTime      @default(now())

  @@unique([portalId, paymentMethodId])
}

model Invoice {
  id               String        @id @default(cuid())
  number           String        @unique // JAR-1001, JAR-1002, …
  portalId         String
  portal           Portal        @relation(fields: [portalId], references: [id])
  payerEmail       String
  payerName        String?
  amount           Decimal
  currency         String        @default("USD")
  status           String        @default("PENDING")
  barcodePayload   String // JARVIS|<number>|<amount>|<currency>
  barcodeQrDataUrl String?
  emailStatus      String        @default("SIMULATED")
  proofHash        String?
  items            String // JSON: [{ description, amount }]
  paymentMethodId  String?
  paymentMethod    PaymentMethod? @relation(fields: [paymentMethodId], references: [id])
  createdAt        DateTime      @default(now())
  paidAt           DateTime?

  payments Payment[]
}

model Payment {
  id         String        @id @default(cuid())
  invoiceId  String
  invoice    Invoice       @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  method     String
  amount     Decimal
  currency   String        @default("USD")
  reference  String? // txHash / Stripe payment_intent / provider ref
  status     String        @default("PENDING")
  simulated  Boolean       @default(true)
  proofHash  String?
  createdAt  DateTime      @default(now())
}

model TrafficLog {
  id              String   @id @default(cuid())
  portalId        String
  portal          Portal   @relation(fields: [portalId], references: [id], onDelete: Cascade)
  ip              String
  userAgent       String?
  path            String?
  hasAccess       Boolean  @default(false)
  ptr             String?
  country         String?
  region          String?
  city            String?
  isp             String?
  org             String?
  lat             Float?
  lon             Float?
  lookupSource    String?
  lookupSimulated Boolean  @default(false)
  createdAt       DateTime @default(now())

  @@index([portalId, createdAt])
  @@index([ip])
}

model BlockedUser {
  id          String   @id @default(cuid())
  portalId    String?
  portal      Portal?  @relation(fields: [portalId], references: [id], onDelete: Cascade)
  email       String?
  ip          String?
  reason      String
  blockedById String
  blockedBy   User     @relation(fields: [blockedById], references: [id])
  createdAt   DateTime @default(now())

  @@index([email])
  @@index([ip])
}

model LinkedAccount {
  id        String   @id @default(cuid())
  portalId  String
  portal    Portal   @relation(fields: [portalId], references: [id], onDelete: Cascade)
  type      String // STRIPE | CASH_APP | EMAIL | DOMAIN | OTHER …
  label     String
  handle    String // public identifier / URL — never a secret
  notes     String?
  createdAt DateTime @default(now())
}

// ID verification — a customer's identity documents for a portal.
// PII: the image files live under server/uploads/id-verifications/ and
// are NEVER served publicly, never logged, and never committed.
// idType has NO passport option (Don's rule): DRIVERS_LICENSE,
// STATE_ID, or NATIONAL_ID only. A re-upload replaces the record
// (upsert on portalId+email) and resets status to PENDING.
// Payment is NOT blocked by verification — an unverified customer can
// still pay; verification is a trust record for Don to review.
model IdVerification {
  id           String    @id @default(cuid())
  portalId     String
  portal       Portal    @relation(fields: [portalId], references: [id], onDelete: Cascade)
  email        String
  idType       String // DRIVERS_LICENSE | STATE_ID | NATIONAL_ID (never PASSPORT)
  frontPath    String // server-side relative path under server/uploads/ — never returned to customers
  backPath     String
  selfiePath   String // the recipient holding the ID
  status       String    @default("PENDING") // PENDING | VERIFIED | REJECTED
  reviewedById String?
  reviewedAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@unique([portalId, email])
  @@index([portalId])
}

// Portal customisation files Don uploads (logo, banner, images,
// documents). Publicly downloadable ONLY through the assets file route,
// which streams by asset id — never a static directory listing.
// ID verification images are a different model and are NEVER reachable
// through the assets route.
model PortalAsset {
  id           String   @id @default(cuid())
  portalId     String
  portal       Portal   @relation(fields: [portalId], references: [id], onDelete: Cascade)
  kind         String // LOGO | BANNER | IMAGE | DOCUMENT | FILE
  originalName String
  storedPath   String // server-side relative path under server/uploads/
  mimeType     String
  size         Int
  uploadedById String
  createdAt    DateTime @default(now())

  @@index([portalId])
}
